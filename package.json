{
  "name": "react-native-journey-recovery",
  "version": "0.2.2",
  "description": "Save and restore multi-step flows (checkout, onboarding, forms) in React Native and Expo after the app is killed, crashes or goes to the background. Checksums, expiry, schema migration, AsyncStorage/MMKV/SecureStore.",
  "type": "commonjs",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:docs": "vite build --config website/vite.config.ts",
    "vercel-build": "npm run build:docs",
    "dev:docs": "vite --config website/vite.config.ts",
    "bench": "vite-node benchmarks/bench-throughput.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run test:coverage && npm run bench && npm run build && npm run lint:package && npm run build:docs",
    "lint:package": "publint && attw --pack .",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run lint:package"
  },
  "keywords": [
    "react-native",
    "react-native-library",
    "expo",
    "react",
    "hooks",
    "typescript",
    "state-restoration",
    "state-persistence",
    "session-recovery",
    "crash-recovery",
    "process-death",
    "app-state",
    "resume",
    "checkpoint",
    "autosave",
    "draft",
    "form-persistence",
    "react-hook-form",
    "checkout",
    "onboarding",
    "wizard",
    "multi-step-form",
    "asyncstorage",
    "mmkv",
    "expo-secure-store",
    "offline",
    "journey"
  ],
  "author": {
    "name": "Imdvlpr99",
    "url": "https://github.com/Imdvlpr99"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Imdvlpr99/react-native-journey-recovery.git"
  },
  "homepage": "https://rn-journey-recovery.vercel.app",
  "bugs": {
    "url": "https://github.com/Imdvlpr99/react-native-journey-recovery/issues"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^14.3.1",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^29.1.1",
    "publint": "^0.3.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-native-web": "^0.21.4",
    "tailwindcss": "^4.3.5",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vite-node": "^3.0.5",
    "vitest": "^3.0.5"
  }
}
